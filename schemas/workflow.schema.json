{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haltseal.com/schemas/payment-control-lab/workflow-0.1.json",
  "title": "Payment Control Lab workflow 0.1",
  "description": "Operator-supplied redacted records for offline diagnostics, not payment authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_type",
    "workflow_name",
    "routes",
    "obligations",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "synthetic",
        "redacted_history"
      ]
    },
    "workflow_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/decision"
          },
          {
            "$ref": "#/$defs/release"
          },
          {
            "$ref": "#/$defs/outcome"
          }
        ]
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "payee_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "obligation_id",
        "attempt_id",
        "route_id",
        "payee_ref",
        "amount_minor",
        "currency"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "coverage": {
          "type": "string",
          "enum": [
            "captured",
            "unobserved"
          ]
        }
      },
      "required": [
        "route_id",
        "label",
        "coverage"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_unit_exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "payee_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        }
      },
      "required": [
        "obligation_id",
        "amount_minor",
        "currency",
        "minor_unit_exponent",
        "payee_ref"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "provider",
            "bank",
            "operator",
            "synthetic"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "reference",
        "final"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "type": {
          "type": "string",
          "const": "decision"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "decision": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "HOLD",
            "REFUSE"
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "event_id",
        "at",
        "type",
        "decision_id",
        "decision",
        "action"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "type": {
          "type": "string",
          "const": "release"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "event_id",
        "at",
        "type",
        "action"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "type": {
          "type": "string",
          "const": "outcome"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
          "maxLength": 80
        },
        "outcome": {
          "type": "string",
          "enum": [
            "unknown",
            "failed_nonfinal",
            "completed",
            "closed_no_effect"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "event_id",
        "at",
        "type",
        "attempt_id",
        "outcome"
      ],
      "additionalProperties": false
    }
  }
}
